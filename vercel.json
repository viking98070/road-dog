{
  "redirects": [
    {
      "source": "/x/:post",
      "destination": "/?utm_source=x&utm_medium=social&utm_campaign=:post",
      "permanent": false
    },
    {
      "source": "/ig/:post",
      "destination": "/?utm_source=instagram&utm_medium=social&utm_campaign=:post",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/trip/:code",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|Slackbot|WhatsApp|Discordbot|LinkedInBot|TelegramBot|Applebot|Pinterestbot|redditbot|SkypeUriPreview|Googlebot|bingbot|Embedly|Iframely|vkShare|Mastodon|Bluesky|Cardyb).*"
        }
      ],
      "destination": "/api/trip-preview?code=:code"
    }
  ]
}
